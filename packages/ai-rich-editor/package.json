{
  "name": "@easyx/ai-rich-editor",
  "version": "0.3.0",
  "description": "AI 驱动的 HTML 片段生产工作台：对话生成自由 HTML 片段、所见即所得预览、片段样式自动作用域化，产物可直接嵌入宿主内容字段",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./parsers": {
      "types": "./dist/parsers/index.d.ts",
      "import": "./dist/parsers/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "rslib --watch",
    "build": "rslib build",
    "test": "rstest",
    "test:watch": "rstest --watch"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@floating-ui/dom": "^1.7.6",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/ai-react": "^0.23.0",
    "marked": "^15.0.12"
  },
  "peerDependencies": {
    "mammoth": "^1.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "unpdf": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "mammoth": {
      "optional": true
    },
    "unpdf": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rslib/core": "^0.23.0",
    "@rstest/adapter-rslib": "^0.10.5",
    "@rstest/core": "^0.10.5",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "mammoth": "^1.12.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "unpdf": "^1.8.1"
  }
}
