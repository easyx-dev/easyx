{
  "name": "@easyx/tiptap-table-plus",
  "version": "1.0.1",
  "description": "Tiptap 表格增强套件，提供单元格样式、选区覆盖层、节点背景色与中英文右键菜单",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/*": "./dist/styles/*",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "rslib --watch",
    "build": "rslib build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/pm": "^3.27.1"
  },
  "devDependencies": {
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rslib/core": "^0.23.0",
    "sass": "^1.101.0",
    "typescript": "^6.0.3"
  }
}
